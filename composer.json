{
    "name": "buckhamduffy/coding-standards",
    "description": "",
    "type": "library",
    "require": {
        "php": "8.5.6",
        "driftingly/rector-laravel": "2.3.0",
        "larastan/larastan": "3.9.6",
        "laravel/framework": "13.9.0",
        "phpstan/phpstan": "2.1.54",
        "rector/rector": "2.4.3",
        "symplify/easy-coding-standard": "12.6.2",
        "captainhook/captainhook": "5.29.2",
        "symfony/process": "7.4.11"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.55",
        "spatie/laravel-data": "4.23.0",
        "captainhook/hook-installer": "1.0.4",
        "spatie/laravel-ray": "1.43.9"
    },
    "autoload": {
        "psr-4": {
            "BuckhamDuffy\\CodingStandards\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Aaron Florey",
            "email": "aaron@buckhamduffy.com"
        },
        {
            "name": "Alex Buckham",
            "email": "alex@buckhamduffy.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Unit\\": "tests/Unit/",
            "Tests\\Unit\\Rector\\": "tests/Unit/Rector/"
        }
    }
}
