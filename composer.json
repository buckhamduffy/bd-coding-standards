{
    "name": "buckhamduffy/coding-standards",
    "description": "",
    "type": "library",
    "require": {
        "php": ">=8.3.0",
        "larastan/larastan": "^3.9.3",
        "laravel/framework": "^12.7 || ^13.0",
        "phpstan/phpstan": "^2.1.32",
        "symplify/easy-coding-standard": "^13.0.0",
        "captainhook/captainhook": "^5.25.2",
        "symfony/process": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.21",
        "captainhook/hook-installer": "^1.0.4",
        "spatie/laravel-ray": "^1.43.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "BuckhamDuffy\\CodingStandards\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Aaron Florey",
            "email": "aaron@buckhamduffy.com"
        },
        {
            "name": "Alex Buckham",
            "email": "alex@buckhamduffy.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
