{
    "name": "buckhamduffy/coding-standards",
    "description": "",
    "type": "library",
    "require": {
        "php": "8.5.7",
        "larastan/larastan": "3.10.0",
        "laravel/framework": "13.18.1",
        "phpstan/phpstan": "2.2.5",
        "symplify/easy-coding-standard": "12.6.2",
        "captainhook/captainhook": "5.29.2",
        "symfony/process": "7.4.13"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.55",
        "captainhook/hook-installer": "1.0.4",
        "spatie/laravel-ray": "1.43.9",
        "squizlabs/php_codesniffer": "3.13.5"
    },
    "autoload": {
        "psr-4": {
            "BuckhamDuffy\\CodingStandards\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Aaron Florey",
            "email": "aaron@buckhamduffy.com"
        },
        {
            "name": "Alex Buckham",
            "email": "alex@buckhamduffy.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
